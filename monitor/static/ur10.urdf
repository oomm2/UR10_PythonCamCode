<?xml version="1.0"?>
<robot name="ur10">
  <link name="base_link"/>
  <link name="base_link_inertia"/>
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry><mesh filename="meshes/ur10/shoulder.dae"/></geometry>
    </visual>
  </link>
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796327 0 -1.570796327"/>
      <geometry><mesh filename="meshes/ur10/upperarm.dae"/></geometry>
    </visual>
  </link>
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796327 0 -1.570796327"/>
      <geometry><mesh filename="meshes/ur10/forearm.dae"/></geometry>
    </visual>
  </link>
  <link name="wrist_1_link">
