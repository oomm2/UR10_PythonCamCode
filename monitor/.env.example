# Copy to .env, then set the same secret on the Mac controller.
# UR_MONITOR_HEARTBEAT_TOKEN in the process environment overrides .env.
#
# Use a random ASCII token without whitespace. At least 32 characters is
# recommended: this secret also gates the CSV recording endpoints.
#
# Generate one on Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 })) -replace '[+/=]',''
#
# Do not commit .env.
UR_MONITOR_HEARTBEAT_TOKEN=
